{
  "display": "form",
  "components": [
    {
      "key": "html",
      "type": "htmlelement",
      "input": false,
      "label": "Instructions",
      "content": "Start a new berichten API case. The berichten  plugin will post a bericht to the open vtb service during execution.",
      "tableView": false,
      "refreshOnChange": false
    },
    {
      "key": "pv:onderwerp",
      "type": "textfield",
      "input": true,
      "label": "Onderwerp",
      "validate": {
        "required": true,
        "maxLength": 50
      },
      "tableView": true,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-onderwerp"
      },
      "applyMaskOn": "change",
      "description": "Onderwerp van het bericht.",
      "placeholder": "Onderwerp van het bericht",
      "defaultValue": "Onderwerp"
    },
    {
      "key": "pv:berichtTekst",
      "type": "textarea",
      "input": true,
      "label": "Bericht tekst",
      "validate": {
        "required": true,
        "maxLength": 4000
      },
      "tableView": true,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-berichtTekst"
      },
      "autoExpand": false,
      "applyMaskOn": "change",
      "description": "Tekst van het bericht.",
      "placeholder": "Bericht tekst",
      "defaultValue": "Bericht tekst"
    },
    {
      "key": "pv:ontvanger",
      "type": "textfield",
      "input": true,
      "label": "Ontvanger",
      "validate": {
        "required": true,
        "maxLength": 255
      },
      "tableView": true,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-ontvanger"
      },
      "applyMaskOn": "change",
      "description": "URN van een NATUURLIJK PERSOON of NIET-NATUURLIJK PERSOON.",
      "placeholder": "urn:namespace:component:resource:uuid",
      "defaultValue": "urn:namespace:component:resource:uuid"
    },
    {
      "key": "pv:mijnOverheidBerichtenbox",
      "type": "checkbox",
      "input": true,
      "label": "MijnOverheid Berichtenbox",
      "tableView": false,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-mijnOverheidBerichtenbox"
      },
      "description": "Geeft aan of dit bericht geschikt is voor publicatie in de MijnOverheid Berichtenbox.",
      "defaultValue": false
    },
    {
      "key": "pv:publicatiedatum",
      "type": "datetime",
      "input": true,
      "label": "Publicatiedatum",
      "widget": {
        "mode": "single",
        "type": "calendar",
        "format": "yyyy-MM-dd hh:mm a",
        "locale": "en",
        "maxDate": null,
        "minDate": null,
        "time_24hr": false,
        "allowInput": true,
        "enableTime": true,
        "noCalendar": false,
        "hourIncrement": 1,
        "minuteIncrement": 1,
        "displayInTimezone": "viewer",
        "useLocaleSettings": false
      },
      "tableView": false,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-publicatiedatum"
      },
      "description": "Datum/tijd waarop bericht zichtbaar moet worden voor de ontvanger."
    },
    {
      "key": "pv:referentie",
      "type": "textfield",
      "input": true,
      "label": "Referentie",
      "validate": {
        "maxLength": 25
      },
      "tableView": true,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-referentie"
      },
      "applyMaskOn": "change",
      "description": "Eigen optionele referentiegegevens, maximaal 25 tekens.",
      "placeholder": "referentie"
    },
    {
      "key": "pv:geopendOp",
      "type": "datetime",
      "input": true,
      "label": "Geopend op",
      "widget": {
        "mode": "single",
        "type": "calendar",
        "format": "yyyy-MM-dd hh:mm a",
        "locale": "en",
        "maxDate": null,
        "minDate": null,
        "time_24hr": false,
        "allowInput": true,
        "enableTime": true,
        "noCalendar": false,
        "hourIncrement": 1,
        "minuteIncrement": 1,
        "displayInTimezone": "viewer",
        "useLocaleSettings": false
      },
      "tableView": false,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-geopendOp"
      },
      "description": "Tijdstip waarop het bericht door de geadresseerde is geopend."
    },
    {
      "key": "pv:berichtType",
      "type": "textfield",
      "input": true,
      "label": "Bericht type",
      "tableView": true,
      "validate": {
        "maxLength": 8
      },
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-berichtType"
      },
      "applyMaskOn": "change",
      "description": "Code voor het technisch identificeren van een bericht soort & origine.",
      "placeholder": "abcde",
      "defaultValue": "abcde"
    },
    {
      "key": "handelingsPerspectief",
      "data": {
        "values": [
          {
            "label": "Betalen",
            "value": "betalen"
          },
          {
            "label": "Incasso",
            "value": "incasso"
          },
          {
            "label": "Informatie geven",
            "value": "informatie_geven"
          },
          {
            "label": "Informatie krijgen",
            "value": "informatie_krijgen"
          },
          {
            "label": "Reactie ontvangen",
            "value": "reactie_ontvangen"
          },
          {
            "label": "Vernieuwing nodig",
            "value": "vernieuwing_nodig"
          },
          {
            "label": "Uitnodiging voor afspraak",
            "value": "uitnodiging_voor_afspraak"
          }
        ]
      },
      "type": "select",
      "input": true,
      "label": "Handelingsperspectief",
      "widget": "choicesjs",
      "tableView": true,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-handelingsPerspectief"
      },
      "description": "De door de toegewezen persoon of bedrijf uit te voeren handeling.",
      "defaultValue": "betalen"
    },
    {
      "key": "pv:handelingsPerspectief",
      "type": "hidden",
      "input": true,
      "label": "Handelingsperspectief (procesvariabele)",
      "tableView": false,
      "clearOnHide": false,
      "calculateValue": "value = data.handelingsPerspectief ? data.handelingsPerspectief : '';",
      "description": "Zet de procesvariabele op de geselecteerde waarde, of leeg wanneer niets is gekozen."
    },
    {
      "key": "pv:urn",
      "type": "hidden",
      "input": true,
      "label": "Bericht URN (procesvariabele)",
      "tableView": false,
      "clearOnHide": false,
      "calculateValue": "value = 'not set';",
      "description": "Zet de procesvariabele vast op een lege waarde, zodat de bericht URN kan worden opgehaald in de volgende stap van de workflow."
    },
    {
      "key": "pv:berichtError",
      "type": "hidden",
      "input": true,
      "label": "Bericht Error (procesvariabele)",
      "tableView": false,
      "clearOnHide": false,
      "calculateValue": "value = '';",
      "description": "Zet de procesvariabele vast op een lege waarde, zodat de bericht Error kan worden opgehaald in de volgende stap van de workflow."
    },
    {
      "key": "pv:einddatumHandelingsTermijn",
      "type": "datetime",
      "input": true,
      "label": "Einddatum handelingstermijn",
      "widget": {
        "mode": "single",
        "type": "calendar",
        "format": "yyyy-MM-dd hh:mm a",
        "locale": "en",
        "maxDate": null,
        "minDate": null,
        "time_24hr": false,
        "allowInput": true,
        "enableTime": true,
        "noCalendar": false,
        "hourIncrement": 1,
        "minuteIncrement": 1,
        "displayInTimezone": "viewer",
        "useLocaleSettings": false
      },
      "tableView": false,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-einddatumHandelingsTermijn"
      },
      "description": "Datum/tijd waarop handeling afgerond moet zijn."
    },
    {
      "key": "isGerelateerdAan",
      "type": "datagrid",
      "input": true,
      "label": "Is gerelateerd aan",
      "reorder": false,
      "initEmpty": false,
      "tableView": false,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-isGerelateerdAan"
      },
      "components": [
        {
          "key": "urn",
          "type": "textfield",
          "input": true,
          "label": "URN",
          "tableView": true,
          "applyMaskOn": "change",
          "description": "URN naar de ZAAK of het PRODUCT.",
          "placeholder": "urn:nld:gemeenteutrecht:zaak:zaaknummer:000350168"
        }
      ],
      "properties": {
        "sourceKey": "pv:isGerelateerdAan"
      },
      "description": "URN's naar de ZAAK of het PRODUCT.",
      "layoutFixed": false,
      "enableRowGroups": false,
      "addAnotherPosition": "bottom"
    },
    {
      "key": "bijlagen",
      "type": "datagrid",
      "input": true,
      "label": "Bijlagen",
      "reorder": false,
      "initEmpty": false,
      "tableView": false,
      "attributes": {
        "data-testid": "openvtb-bericht-creatie-pv-bijlagen"
      },
      "components": [
        {
          "key": "informatieObject",
          "type": "textfield",
          "input": true,
          "label": "Informatieobject",
          "tableView": true,
          "applyMaskOn": "change",
          "description": "URN naar het ENKELVOUDIGINFORMATIEOBJECT."
        },
        {
          "key": "omschrijving",
          "type": "textfield",
          "input": true,
          "label": "Omschrijving",
          "tableView": true,
          "applyMaskOn": "change",
          "description": "Goed leesbare omschrijving van de bijlage."
        },
        {
          "key": "isBerichtTypeBijlage",
          "type": "checkbox",
          "input": true,
          "label": "Is bericht type bijlage",
          "tableView": false,
          "description": "Geeft aan of dit document een standaardbijlage is.",
          "defaultValue": false
        }
      ],
      "properties": {
        "sourceKey": "pv:bijlagen"
      },
      "description": "Lijst van bijlagen bij het bericht.",
      "layoutFixed": false,
      "defaultValue": [
        {
          "omschrijving": "",
          "informatieObject": "",
          "isBerichtTypeBijlage": false
        }
      ],
      "enableRowGroups": false,
      "addAnotherPosition": "bottom"
    },
    {
      "key": "submit",
      "type": "button",
      "input": true,
      "label": "Verzenden",
      "tableView": false,
      "disableOnInvalid": true
    }
  ]
}
