{
    "display": "form",
    "components": [
        {
            "key": "html",
            "type": "htmlelement",
            "input": false,
            "label": "Instructions",
            "content": "Start a new berichten API case. The berichten  plugin will post a bericht to the open vtb service during execution.",
            "tableView": false,
            "refreshOnChange": false
        },
        {
            "key": "name",
            "type": "textfield",
            "input": true,
            "label": "Name",
            "tableView": true,
            "applyMaskOn": "change",
            "defaultValue": "Harrie"
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Start",
            "tableView": false,
            "disableOnInvalid": true
        }
    ]
}
