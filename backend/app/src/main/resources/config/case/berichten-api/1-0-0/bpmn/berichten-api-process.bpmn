        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_00xe3x6_di" bpmnElement="Activity_18ql9dt">
        <dc:Bounds x="490" y="320" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0678nat_di" bpmnElement="Event_0678nat">
        <dc:Bounds x="682" y="342" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="end-event">
        <dc:Bounds x="1002" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="984" y="225" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_1_di" bpmnElement="bericht-aanmaken">
        <dc:Bounds x="630" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0glbdy2_di" bpmnElement="wacht-effe">
        <dc:Bounds x="790" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="200" />
        <di:waypoint x="355" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="730" y="200" />
        <di:waypoint x="790" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0403nz4_di" bpmnElement="Flow_0403nz4">
        <di:waypoint x="405" y="200" />
        <di:waypoint x="490" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19l6ef4_di" bpmnElement="Flow_19l6ef4">
        <di:waypoint x="380" y="225" />
        <di:waypoint x="380" y="360" />
        <di:waypoint x="490" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1s59831_di" bpmnElement="Flow_1s59831">
        <di:waypoint x="590" y="200" />
        <di:waypoint x="630" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14uxvvt_di" bpmnElement="Flow_14uxvvt">
        <di:waypoint x="590" y="360" />
        <di:waypoint x="682" y="360" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0tjxhtg_di" bpmnElement="Flow_0tjxhtg">
