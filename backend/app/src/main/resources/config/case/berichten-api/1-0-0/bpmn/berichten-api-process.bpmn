<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.23.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="berichten-api-participant" name="Berichten API Process" processRef="berichten-api-process" />
  </bpmn:collaboration>
  <bpmn:process id="berichten-api-process" name="Berichten API Process" isExecutable="true">
    <bpmn:startEvent id="start-event" name="Process started">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="start-event" targetRef="vul-bericht-velden" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="bericht-aanmaken" targetRef="Gateway_1973sl4" />
    <bpmn:sequenceFlow id="Flow_0403nz4" sourceRef="Gateway_0l9irve" targetRef="bericht-aanmaken" />
    <bpmn:sequenceFlow id="Flow_19l6ef4" sourceRef="Gateway_0l9irve" targetRef="CallOpenVTBBerichtAanmakenActivity">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.hasVariable("genereer-bericht-flow") &amp;&amp; execution.getVariable("genereer-bericht-flow") == "MET_BOUWBLOK" }</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_0l9irve" camunda:asyncBefore="true" default="Flow_0403nz4">
      <bpmn:incoming>Flow_09nos4r</bpmn:incoming>
      <bpmn:outgoing>Flow_0403nz4</bpmn:outgoing>
      <bpmn:outgoing>Flow_19l6ef4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="vul-bericht-velden" name="vul bericht velden">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_09nos4r</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_09nos4r" sourceRef="vul-bericht-velden" targetRef="Gateway_0l9irve" />
    <bpmn:serviceTask id="bericht-aanmaken" name="Bericht aanmaken" camunda:expression="${true}" camunda:resultVariable="urn">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_0403nz4</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_1973sl4">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:incoming>Flow_0b3dot6</bpmn:incoming>
      <bpmn:outgoing>Flow_1y61cor</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1y61cor" sourceRef="Gateway_1973sl4" targetRef="end-event" />
    <bpmn:sequenceFlow id="Flow_0b3dot6" sourceRef="CallOpenVTBBerichtAanmakenActivity" targetRef="Gateway_1973sl4" />
    <bpmn:endEvent id="end-event" name="Process ended">
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.hasVariable(&#39;berichtUrn&#39;) &#38;&#38; valueResolverDelegateService.handleValue(execution, &#39;doc:/urn&#39;, berichtUrn)}" event="start" />
        <camunda:executionListener expression="${execution.hasVariable(&#39;berichtError&#39;) &#38;&#38; valueResolverDelegateService.handleValue(execution, &#39;doc:/berichtError&#39;, berichtError)}" event="start" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1y61cor</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="CallOpenVTBBerichtAanmakenActivity" name="Bericht aanmaken met bouwblok" calledElement="openvtb-bericht-creatie-proces" camunda:calledElementBinding="versionTag" camunda:calledElementVersionTag="BB:openvtb-bericht-creatie:0.0.1">
      <bpmn:extensionElements>
        <camunda:in businessKey="#{buildingBlockDocumentId}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19l6ef4</bpmn:incoming>
      <bpmn:outgoing>Flow_0b3dot6</bpmn:outgoing>
    </bpmn:callActivity>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="berichten-api-participant" isHorizontal="true">
        <dc:Bounds x="160" y="100" width="880" height="350" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="start-event">
        <dc:Bounds x="232" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="214" y="225" width="73" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_0l9irve_di" bpmnElement="Gateway_0l9irve" isMarkerVisible="true">
        <dc:Bounds x="505" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_15b0p7l" bpmnElement="vul-bericht-velden">
        <dc:Bounds x="340" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ServiceTask_1_di" bpmnElement="bericht-aanmaken">
        <dc:Bounds x="620" y="160" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_1973sl4_di" bpmnElement="Gateway_1973sl4" isMarkerVisible="true">
        <dc:Bounds x="795" y="175" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="end-event">
        <dc:Bounds x="912" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="894" y="225" width="74" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1uf48le_di" bpmnElement="CallOpenVTBBerichtAanmakenActivity">
        <dc:Bounds x="620" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="268" y="200" />
        <di:waypoint x="340" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="720" y="200" />
        <di:waypoint x="795" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0403nz4_di" bpmnElement="Flow_0403nz4">
        <di:waypoint x="555" y="200" />
        <di:waypoint x="620" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19l6ef4_di" bpmnElement="Flow_19l6ef4">
        <di:waypoint x="530" y="225" />
        <di:waypoint x="530" y="340" />
        <di:waypoint x="620" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09nos4r_di" bpmnElement="Flow_09nos4r">
        <di:waypoint x="440" y="200" />
        <di:waypoint x="505" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1y61cor_di" bpmnElement="Flow_1y61cor">
        <di:waypoint x="845" y="200" />
        <di:waypoint x="912" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0b3dot6_di" bpmnElement="Flow_0b3dot6">
        <di:waypoint x="720" y="340" />
        <di:waypoint x="820" y="340" />
        <di:waypoint x="820" y="225" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
