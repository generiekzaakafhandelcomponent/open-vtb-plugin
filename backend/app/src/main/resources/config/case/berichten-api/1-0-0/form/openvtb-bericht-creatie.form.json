{
  "display": "form",
  "components": [
    {
      "key": "html",
      "type": "htmlelement",
      "input": false,
      "label": "Instructions",
      "content": "Start a new berichten API case. The berichten  plugin will post a bericht to the open vtb service during execution.",
      "tableView": false,
      "refreshOnChange": false
    },
    {
      "key": "pv:onderwerp",
      "type": "textfield",
      "input": true,
      "label": "Onderwerp",
      "tableView": true,
      "applyMaskOn": "change",
      "description": "Onderwerp van het bericht.",
      "validate": {
        "required": true
      },
      "defaultValue": "Onderwerp 07"
    },
    {
      "key": "pv:berichtTekst",
      "type": "textarea",
      "input": true,
      "label": "Bericht tekst",
      "tableView": true,
      "autoExpand": false,
      "applyMaskOn": "change",
      "description": "Tekst van het bericht.",
      "validate": {
        "required": true
      },
      "defaultValue": "Bericht tekst 07"
    },
    {
      "key": "pv:ontvanger",
      "type": "textfield",
      "input": true,
      "label": "Ontvanger",
      "tableView": true,
      "applyMaskOn": "change",
      "description": "URN van een NATUURLIJK PERSOON of NIET-NATUURLIJK PERSOON.",
      "validate": {
        "required": true
      },
      "defaultValue": "urn:isbn:9780143127796"
    },
    {
      "key": "pv:mijnOverheidBerichtenbox",
      "type": "checkbox",
      "input": true,
      "label": "MijnOverheid Berichtenbox",
      "tableView": false,
      "description": "Geeft aan of dit bericht geschikt is voor publicatie in de MijnOverheid Berichtenbox.",
      "defaultValue": true,
      "validate": {
        "required": true
      }
    },
    {
      "key": "pv:publicatiedatum",
      "type": "datetime",
      "input": true,
      "label": "Publicatiedatum",
      "tableView": false,
      "enableTime": true,
      "widget": {
        "type": "calendar"
      },
      "description": "Datum/tijd waarop bericht zichtbaar moet worden voor de ontvanger.",
      "defaultValue": "2026-08-24T14:15:22Z"
    },
    {
      "key": "pv:referentie",
      "type": "textfield",
      "input": true,
      "label": "Referentie",
      "tableView": true,
      "applyMaskOn": "change",
      "description": "Eigen optionele referentiegegevens, maximaal 25 tekens.",
      "validate": {
        "maxLength": 25
      },
      "defaultValue": "referentie 07"
    },
    {
      "key": "pv:geopendOp",
      "type": "datetime",
      "input": true,
      "label": "Geopend op",
      "tableView": false,
      "enableTime": true,
      "widget": {
        "type": "calendar"
      },
      "description": "Tijdstip waarop het bericht door de geadresseerde is geopend.",
      "defaultValue": "2026-08-24T14:15:22Z"
    },
    {
      "key": "pv:berichtType",
      "type": "textfield",
      "input": true,
      "label": "Bericht type",
      "tableView": true,
      "applyMaskOn": "change",
      "description": "Code voor het technisch identificeren van een bericht soort & origine.",
      "defaultValue": "type07"
    },
    {
      "key": "pv:handelingsPerspectief",
      "type": "select",
      "input": true,
      "label": "Handelingsperspectief",
      "widget": "choicesjs",
      "tableView": true,
      "description": "De door de toegewezen persoon of bedrijf uit te voeren handeling.",
      "dataSrc": "values",
      "data": {
        "values": [
          {
            "label": "Betalen",
            "value": "betalen"
          },
          {
            "label": "Incasso",
            "value": "incasso"
          },
          {
            "label": "Informatie geven",
            "value": "informatie_geven"
          },
          {
            "label": "Informatie krijgen",
            "value": "informatie_krijgen"
          },
          {
            "label": "Reactie ontvangen",
            "value": "reactie_ontvangen"
          },
          {
            "label": "Vernieuwing nodig",
            "value": "vernieuwing_nodig"
          },
          {
            "label": "Uitnodiging voor afspraak",
            "value": "uitnodiging_voor_afspraak"
          }
        ]
      },
      "defaultValue": "incasso"
    },
    {
      "key": "pv:einddatumHandelingsTermijn",
      "type": "datetime",
      "input": true,
      "label": "Einddatum handelingstermijn",
      "tableView": false,
      "enableTime": true,
      "widget": {
        "type": "calendar"
      },
      "description": "Datum/tijd waarop handeling afgerond moet zijn.",
      "defaultValue": "2026-08-24T14:15:22Z"
    },
    {
      "key": "pv:isGerelateerdAan",
      "type": "datagrid",
      "input": true,
      "label": "Is gerelateerd aan",
      "reorder": false,
      "tableView": false,
      "description": "URN's naar de ZAAK of het PRODUCT.",
      "validate": {
        "required": false
      },
      "defaultValue": [
        {
          "urn": "urn:nld:gemeenteutrecht:zaak:zaaknummer:000350165"
        }
      ],
      "components": [
        {
          "key": "urn",
          "type": "textfield",
          "input": true,
          "label": "URN",
          "tableView": true,
          "applyMaskOn": "change",
          "description": "URN naar de ZAAK of het PRODUCT.",
          "validate": {
            "required": false
          },
          "defaultValue": "urn:nld:gemeenteutrecht:zaak:zaaknummer:000350165"
        }
      ]
    },
    {
      "key": "pv:bijlagen",
      "type": "datagrid",
      "input": true,
      "label": "Bijlagen",
      "reorder": false,
      "tableView": false,
      "description": "Lijst van bijlagen bij het bericht.",
      "validate": {
        "required": false
      },
      "components": [
        {
          "key": "informatieObject",
          "type": "textfield",
          "input": true,
          "label": "Informatieobject",
          "tableView": true,
          "applyMaskOn": "change",
          "description": "URN naar het ENKELVOUDIGINFORMATIEOBJECT.",
          "validate": {
            "required": false
          }
        },
        {
          "key": "omschrijving",
          "type": "textfield",
          "input": true,
          "label": "Omschrijving",
          "tableView": true,
          "applyMaskOn": "change",
          "description": "Goed leesbare omschrijving van de bijlage."
        },
        {
          "key": "isBerichtTypeBijlage",
          "type": "checkbox",
          "input": true,
          "label": "Is bericht type bijlage",
          "tableView": false,
          "description": "Geeft aan of dit document een standaardbijlage is.",
          "defaultValue": false
        }
      ]
    },
    {
      "key": "submit",
      "type": "button",
      "input": true,
      "label": "Verzenden",
      "action": "submit",
      "tableView": false,
      "disableOnInvalid": true
    }
  ]
}
